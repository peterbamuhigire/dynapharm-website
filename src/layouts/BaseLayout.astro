---
import { getAlternateLang, getLocalizedPath, SUPPORTED_LANGS, t } from '@utils/i18n';
import type { Lang } from '@utils/i18n';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import '@styles/global.css';
import { getImage } from 'astro:assets';
import brandLogo from '@assets/images/branding/Logo-Full-Color.png';
import brandIcon from '@assets/images/branding/Logo-Dark-Mode.png';
import { frontmatter as englishSearch } from '../../docs/en/search-metadata.md';
import { frontmatter as frenchSearch } from '../../docs/fr/search-metadata.md';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: string;
  locale?: string;
  keywords?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Optional override for cross-language URLs — used by pages whose
   * slug differs per language (e.g. blog posts). Keys are language codes,
   * values are pathnames such as `/fr/blog/bienfaits-du-ginkgo-biloba`. */
  alternates?: Partial<Record<Lang, string>>;
}

const {
  title: pageTitle,
  description: pageDescription,
  lang = 'en' as Lang,
  ogImage,
  ogImageAlt = pageTitle,
  ogImageWidth,
  ogImageHeight,
  ogType = 'website',
  locale,
  keywords,
  structuredData,
  alternates,
} = Astro.props;

const routeKey = Astro.url.pathname.replace(/^\/(en|fr)\/?/, '').replace(/\/$/, '');
const searchContent = lang === 'fr' ? frenchSearch : englishSearch;
const metadata = searchContent.pages[routeKey] || {};
const title = metadata.title || pageTitle;
const description = metadata.description || pageDescription;
const siteUrl = Astro.site?.href || 'https://dynapharmafrica.com/';
const absoluteUrl = (path: string) => {
  const url = new URL(path, siteUrl);
  if (!url.pathname.endsWith('/') && !/\.[a-z0-9]+$/i.test(url.pathname)) url.pathname += '/';
  return url.href;
};
const canonicalUrl = new URL(absoluteUrl(Astro.url.pathname));
const socialLogo = await getImage({ src: brandLogo, width: 982, format: 'png' });
const favicon = await getImage({ src: brandIcon, width: 64, format: 'png' });
const ogImageUrl = new URL(ogImage || socialLogo.src, siteUrl).href;
const socialWidth = ogImage ? ogImageWidth : socialLogo.attributes.width;
const socialHeight = ogImage ? ogImageHeight : socialLogo.attributes.height;
const suppliedSchemas = !structuredData ? [] : Array.isArray(structuredData) ? structuredData : [structuredData];
const hasBreadcrumb = suppliedSchemas.some((schema) => schema['@type'] === 'BreadcrumbList');
const hasWebPage = suppliedSchemas.some((schema) => ['WebPage', 'CollectionPage'].includes(String(schema['@type'])));

const localeMap: Record<string, string> = {
  en: 'en_GB',
  fr: 'fr_FR',
};

// Organization schema — site-wide
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}#organization`,
  name: 'Dynapharm Africa',
  url: siteUrl,
  logo: absoluteUrl(socialLogo.src),
  description: lang === 'fr'
    ? 'Entreprise internationale de santé et bien-être proposant plus de 90 produits naturels et une opportunité d\'affaires éprouvée dans plus de 40 pays en Afrique.'
    : 'International health and wellness company offering 90+ natural products and a proven business opportunity across 40+ countries in Africa and beyond.',
  email: 'info@dynapharmafrica.com',
  foundingDate: '1981',
  knowsLanguage: ['en', 'fr'],
  areaServed: [
    { '@type': 'Continent', name: 'Africa' },
    'Uganda', 'Kenya', 'Nigeria', 'Senegal', 'Ghana', 'Tanzania',
    'Cameroon', 'Gabon', 'Zambia', 'Mozambique', 'Lesotho',
    'Sierra Leone', 'Rwanda', 'Burundi', 'DR Congo', 'Republic of the Congo',
    "Côte d'Ivoire", 'Mali', 'Burkina Faso', 'Niger', 'Togo', 'Benin',
    'Guinea', 'Madagascar', 'Malawi', 'Zimbabwe', 'Botswana',
    'Namibia', 'South Africa', 'Ethiopia', 'Sudan', 'South Sudan',
    'Angola', 'Eswatini', 'Liberia', 'Gambia', 'Chad',
  ],
  sameAs: [],
};

// BreadcrumbList schema for inner pages
const pathSegments = Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '').split('/');
const isHomePage = pathSegments.length <= 1 || (pathSegments.length === 2 && pathSegments[1] === '');
const breadcrumbSchema = !isHomePage && !hasBreadcrumb ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: lang === 'fr' ? 'Accueil' : 'Home',
      item: `${siteUrl}${lang}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: title.split('—')[0].split('|')[0].trim(),
      item: canonicalUrl.href,
    },
  ],
} : null;

// Resolve the path for the alternate language so the language
// switcher links to the correct localized URL even when slugs differ.
const altLang = getAlternateLang(lang);
const altPath = alternates?.[altLang] ?? getLocalizedPath(Astro.url.pathname, altLang);

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}#website`,
  url: siteUrl,
  name: 'Dynapharm Africa',
  inLanguage: ['en', 'fr'],
  publisher: { '@id': `${siteUrl}#organization` },
};
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonicalUrl.href,
  url: canonicalUrl.href,
  name: title,
  description,
  inLanguage: lang,
  isPartOf: { '@id': `${siteUrl}#website` },
};
const allSchemas: Record<string, unknown>[] = [organizationSchema, websiteSchema, ...suppliedSchemas];
if (breadcrumbSchema) allSchemas.push(breadcrumbSchema);
if (!hasWebPage) allSchemas.push(webPageSchema);

---

<!DOCTYPE html>
<html lang={lang} dir="ltr" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}

    <!-- Geo targeting — Africa -->
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="describedby" type="text/plain" href={new URL('/llms.txt', siteUrl).href} />
    {routeKey === 'country-profiles/senegal' && (
      <link rel="alternate" type="text/markdown" href={new URL('index.md', canonicalUrl).href} />
    )}

    <!-- Hreflang alternates -->
    {SUPPORTED_LANGS.map((l) => (
      <link
        rel="alternate"
        hreflang={l}
        href={absoluteUrl(alternates?.[l] ?? getLocalizedPath(Astro.url.pathname, l))}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={absoluteUrl(alternates?.en ?? getLocalizedPath(Astro.url.pathname, 'en'))}
    />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Dynapharm Africa" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:locale" content={locale || localeMap[lang]} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale:alternate" content={localeMap[getAlternateLang(lang)]} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {socialWidth && <meta property="og:image:width" content={socialWidth} />}
    {socialHeight && <meta property="og:image:height" content={socialHeight} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="64x64" href={favicon.src} />

    <!-- Fonts are self-hosted via Fontsource (@import in global.css) and ship with
         font-display: swap, so no external preconnect/CDN handshake is needed. -->
    <meta name="theme-color" content="#C41E3A" />

    <!-- Structured Data -->
    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col bg-cream text-charcoal font-body antialiased">
    <!-- Skip to content (accessibility) -->
    <a href="#main-content" class="skip-to-content">
      {lang === 'en' ? 'Skip to content' : 'Aller au contenu'}
    </a>

    <Header lang={lang} altPath={altPath} />

    <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>

    <Footer lang={lang} altPath={altPath} />

    <!-- Back to top button -->
    <button
      type="button"
      class="fixed bottom-6 right-6 z-40 w-11 h-11 rounded-full bg-dynared text-white shadow-lg hover:bg-dynared-dark hover:shadow-xl transition-all duration-300 flex items-center justify-center focus:outline-2 focus:outline-dynared focus:outline-offset-2"
      x-data="{ visible: false }"
      x-init="window.addEventListener('scroll', () => { visible = window.scrollY > 400 })"
      x-show="visible"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0 scale-90"
      x-transition:enter-end="opacity-100 scale-100"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100 scale-100"
      x-transition:leave-end="opacity-0 scale-90"
      x-cloak
      x-on:click="window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' })"
      aria-label={t(lang, 'common', 'backToTop')}
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
      </svg>
    </button>

    <style>
      [x-cloak] {
        display: none !important;
      }
    </style>
  </body>
</html>
