    ],
    cta: {
      heading: 'Trouvez Votre DPC Kenya le Plus Proche',
      body: 'Utilisez l annuaire ci-dessus pour relier votre ville, quartier ou corridor de deplacement au site Dynapharm Kenya le plus proche.',
      primary: 'Explorer les Produits',
      secondary: 'Retour aux Profils Pays',
    },
    backLink: 'Retour aux Profils des Pays',
    aboutCountry: 'A propos du pays',
