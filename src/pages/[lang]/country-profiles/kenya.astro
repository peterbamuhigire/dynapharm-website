      keywords: 'Dynapharm Kenya, Dynapharm Nairobi, Dynapharm Mombasa, Dynapharm Kisumu, Dynapharm Nakuru, Dynapharm Eldoret, Dynapharm Thika, Dynapharm Nyeri, Dynapharm Kitale, Dynapharm Ruiru, Dynapharm Kitengela, Dynapharm Kasarani, Dynapharm Buruburu, Dynapharm Hazina Towers, Dynapharm Sanlam, Dynapharm Norwich, Dynapharm Accra Road, natural health products Kenya, Spirulina Kenya, Ganoderma coffee Kenya, Chlorophyll Kenya, Dynapharm distributor Kenya, wellness business Kenya',
    },
    breadcrumbCountries: 'Country Profiles',
    breadcrumbThis: 'Kenya',
    hero: {
      eyebrow: 'Country Profile - Republic of Kenya',
      heading: 'Dynapharm Kenya',
      subtitle: 'Eighteen DPC locations, one shared mission - bringing natural wellness and business support to Kenyan communities from Nairobi to the coast and the Rift Valley.',
      flagAlt: 'National flag of the Republic of Kenya',
