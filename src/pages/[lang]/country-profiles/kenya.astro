const c = content[lang];
const factEntries = Object.entries(c.factLabels) as [keyof typeof c.factLabels, string][];
const siteHref = (Astro.site?.href || 'https://dynapharmafrica.com/').replace(/\/$/, '');
const pageUrl = `${siteHref}/${lang}/country-profiles/kenya`;
const pageImage = `${siteHref}${heroBg.src}`;

const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: c.breadcrumbCountries, item: `${siteHref}/${lang}/country-profiles` },
    { '@type': 'ListItem', position: 2, name: c.breadcrumbThis, item: pageUrl },
  ],
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: c.meta.title,
  url: pageUrl,
  description: c.meta.description,
  inLanguage: lang,
  image: pageImage,
  about: [
    { '@type': 'Organization', name: 'Dynapharm Kenya' },
    { '@type': 'Country', name: 'Kenya' },
    { '@type': 'Thing', name: 'Dynapharm DPC locations in Kenya' },
  ],
  keywords: c.meta.keywords,
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Dynapharm Kenya',
  alternateName: ['Dynapharm Kenya DPC', 'Dynapharm Kenya locations'],
  url: pageUrl,
  parentOrganization: { '@type': 'Organization', name: 'Dynapharm International', url: 'https://www.dynapharm.com.my/' },
  areaServed: { '@type': 'Country', name: 'Kenya' },
  description: lang === 'fr'
    ? 'Dynapharm Kenya dessert les clients et distributeurs via 18 sites DPC a Nairobi, Mombasa, Kisumu, Nakuru, Eldoret, Thika, Nyeri et au-dela.'
    : 'Dynapharm Kenya serves customers and distributors through 18 DPC locations in Nairobi, Mombasa, Kisumu, Nakuru, Eldoret, Thika, Nyeri and beyond.',
  location: locations.map((loc) => ({
    '@type': 'HealthAndBeautyBusiness',
    '@id': `${pageUrl}#${slugify(loc.name)}`,
    name: `Dynapharm Kenya ${loc.name} DPC`,
    branchOf: { '@type': 'Organization', name: 'Dynapharm Kenya' },
    address: {
      '@type': 'PostalAddress',
      streetAddress: loc.address,
      addressLocality: loc.locality,
      addressRegion: loc.county,
      addressCountry: 'KE',
    },
    areaServed: loc.locality,
  })),
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Dynapharm Kenya DPC Locations',
  numberOfItems: locations.length,
  itemListElement: locations.map((loc, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: `Dynapharm Kenya ${loc.name}`,
    url: `${pageUrl}#${slugify(loc.name)}`,
    description: `${loc.address}, ${loc.locality}, ${loc.county}`,
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={c.meta.title}
  description={c.meta.description}
  keywords={c.meta.keywords}
  lang={lang}
  ogImage={heroBg.src}
  structuredData={[breadcrumbSchema, webPageSchema, orgSchema, itemListSchema, faqSchema]}
>
  <section
    class="relative overflow-hidden text-white"
    style={`background-image: linear-gradient(115deg, rgba(12,48,18,0.88), rgba(20,20,20,0.58) 48%, rgba(154,22,48,0.74)), url('${heroBg.src}'); background-size: cover; background-position: center;`}
    aria-label={c.hero.flagAlt}
  >
    <div class="absolute inset-0 grain-overlay opacity-25"></div>
    <div class="section-container relative z-10 py-20 md:py-28 lg:py-36">
      <nav class="mb-6 text-sm font-accent text-grey-light/90" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={`/${lang}`} class="hover:text-white transition-colors">{lang === 'fr' ? 'Accueil' : 'Home'}</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={`/${lang}/country-profiles`} class="hover:text-white transition-colors">{c.breadcrumbCountries}</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-white" aria-current="page">{c.breadcrumbThis}</li>
        </ol>
      </nav>
      <div class="max-w-4xl">
        <p class="font-accent text-sm uppercase tracking-widest text-white/80 mb-3">
          {c.hero.eyebrow}
        </p>
        <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold mb-5 drop-shadow-lg">
          {c.hero.heading}
        </h1>
        <p class="font-body text-lg md:text-xl text-white/90 max-w-3xl drop-shadow">
          {c.hero.subtitle}
        </p>
      </div>
      <dl class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-4 max-w-4xl">
        {c.overview.stats.map((s) => (
          <div class="rounded-2xl border border-white/20 bg-white/10 p-4 backdrop-blur-sm">
            <dt class="font-accent text-xs uppercase tracking-wider text-white/72">{s.label}</dt>
            <dd class="font-heading text-2xl md:text-3xl font-bold text-white">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-none">
      <svg viewBox="0 0 1200 60" preserveAspectRatio="none" class="w-full h-8 md:h-12">
        <polygon fill="var(--color-cream)" points="0,60 1200,60 1200,0"></polygon>
      </svg>
    </div>
  </section>

  <section class="section-padding bg-cream">
    <div class="section-container">
      <div class="grid gap-12 lg:grid-cols-5 lg:items-center">
        <div class="lg:col-span-3">
          <h2 class="font-heading text-2xl md:text-3xl font-bold text-charcoal mb-4 flex items-center gap-3">
            <span class="w-1 h-8 bg-green rounded-full inline-block" aria-hidden="true"></span>
            {c.overview.heading}
          </h2>
          <p class="font-body text-base md:text-lg text-charcoal-light leading-relaxed mb-4">{c.overview.p1}</p>
          <p class="font-body text-base md:text-lg text-charcoal-light leading-relaxed mb-4">{c.overview.p2}</p>
          <p class="font-body text-base md:text-lg text-charcoal-light leading-relaxed">{c.overview.p3}</p>
        </div>
        <div class="lg:col-span-2">
          <div class="rounded-2xl overflow-hidden bg-white p-4 border border-grey-light/40 shadow-card">
            <Image
              src={kenyaMapFlag}
              alt={c.overview.mapAlt}
              class="w-full h-auto"
              widths={[400, 800]}
              sizes="(min-width: 1024px) 400px, 80vw"
              loading="lazy"
            />
          </div>
          <dl class="mt-4 bg-white rounded-2xl border border-grey-light/40 p-5 shadow-sm">
            <p class="font-accent text-xs uppercase tracking-wider text-dynared font-semibold mb-3">{c.aboutCountry}</p>
            {factEntries.map(([key, label]) => (
              <div class="flex justify-between gap-4 py-2 border-b border-grey-light/30 last:border-0">
                <dt class="font-accent text-sm text-charcoal-light">{label}</dt>
                <dd class="font-body text-sm text-charcoal text-right">{c.countryFacts[key]}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white">
    <div class="section-container">
      <div class="mb-10 max-w-3xl">
        <h2 class="font-heading text-2xl md:text-3xl font-bold text-charcoal mb-3 flex items-center gap-3">
          <span class="w-1 h-8 bg-dynared rounded-full inline-block" aria-hidden="true"></span>
          {c.clusters.heading}
        </h2>
        <p class="font-body text-base md:text-lg text-charcoal-light leading-relaxed">
          {c.clusters.subtitle}
        </p>
      </div>

      <div class="grid gap-6 lg:grid-cols-4">
        {clusters.map((cluster) => (
          <article class="bg-cream rounded-2xl border border-grey-light/40 p-6 shadow-sm">
            <h3 class="font-heading text-xl font-bold text-charcoal mb-3">{cluster.name[lang]}</h3>
            <p class="font-body text-sm text-charcoal-light leading-relaxed mb-5">{cluster.body[lang]}</p>
            <p class="font-accent text-xs uppercase tracking-wider text-dynared font-semibold mb-2">{c.clusters.placesLabel}</p>
            <div class="flex flex-wrap gap-2">
              {cluster.places.map((place) => (
                <a href={`#${slugify(place)}`} class="inline-flex rounded-full bg-white px-3 py-1 text-xs font-accent font-semibold text-charcoal hover:text-dynared transition-colors">
                  {place}
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-cream">
    <div class="section-container">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <h2 class="font-heading text-2xl md:text-3xl font-bold text-charcoal mb-4 flex items-center gap-3">
            <span class="w-1 h-8 bg-green rounded-full inline-block" aria-hidden="true"></span>
            {c.feature.heading}
          </h2>
          <p class="font-body text-base md:text-lg text-charcoal-light leading-relaxed mb-6">
            {c.feature.body}
          </p>
          <ul class="space-y-3">
            {c.feature.points.map((point) => (
              <li class="flex gap-3 font-body text-charcoal-light">
                <span class="mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-green/10 text-green flex items-center justify-center" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.704 5.29a1 1 0 010 1.42l-7.25 7.2a1 1 0 01-1.41 0L3.296 9.18a1 1 0 111.41-1.42l4.04 4.02 6.54-6.49a1 1 0 011.418 0z" clip-rule="evenodd" />
                  </svg>
                </span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl overflow-hidden border border-grey-light/40 bg-white p-3 shadow-sm">
            <Image
              src={kenyaMapCloseup}
              alt={c.overview.mapAlt}
              class="w-full h-full object-cover rounded-xl aspect-square"
              widths={[400, 700]}
              sizes="(min-width: 1024px) 300px, 50vw"
              loading="lazy"
            />
          </div>
          <div class="rounded-2xl overflow-hidden border border-grey-light/40 bg-white p-3 shadow-sm sm:mt-10">
            <Image
              src={kenyaCoastFlag}
              alt={c.feature.imageAlt}
              class="w-full h-full object-cover rounded-xl aspect-square"
              widths={[400, 700]}
              sizes="(min-width: 1024px) 300px, 50vw"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white">
    <div class="section-container">
      <div class="mb-10 max-w-3xl">
        <h2 class="font-heading text-2xl md:text-3xl font-bold text-charcoal mb-3 flex items-center gap-3">
          <span class="w-1 h-8 bg-dynared rounded-full inline-block" aria-hidden="true"></span>
          {c.dpcs.heading}
        </h2>
        <p class="font-body text-base md:text-lg text-charcoal-light leading-relaxed">
          {c.dpcs.subtitle}
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {locations.map((loc) => (
          <article id={slugify(loc.name)} class="bg-cream rounded-2xl border border-grey-light/40 p-6 shadow-sm hover:shadow-md hover:border-dynared/40 transition-all duration-200 scroll-mt-28" itemscope itemtype="https://schema.org/HealthAndBeautyBusiness">
            <meta itemprop="name" content={`Dynapharm Kenya ${loc.name} DPC`} />
            <div class="flex items-start gap-3 mb-4">
              <span class="flex-shrink-0 w-10 h-10 rounded-full bg-dynared/10 text-dynared flex items-center justify-center" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </span>
              <div>
                <h3 class="font-heading text-xl font-bold text-charcoal leading-tight">{loc.name}</h3>
                <p class="font-accent text-xs uppercase tracking-wider text-dynared mt-1">{loc.corridor}</p>
              </div>
            </div>
            <dl class="text-sm mb-4 space-y-2">
              <div class="flex gap-2">
                <dt class="font-accent text-charcoal-light">{c.dpcs.addressLabel}:</dt>
                <dd class="font-body text-charcoal">{loc.address}</dd>
              </div>
              <div class="flex gap-2">
                <dt class="font-accent text-charcoal-light">{c.dpcs.localityLabel}:</dt>
                <dd class="font-body text-charcoal" itemprop="addressLocality">{loc.locality}</dd>
              </div>
              <div class="flex gap-2">
                <dt class="font-accent text-charcoal-light">{c.dpcs.countyLabel}:</dt>
                <dd class="font-body text-charcoal" itemprop="addressRegion">{loc.county}</dd>
              </div>
            </dl>
            <address class="font-body not-italic text-sm text-charcoal-light leading-relaxed mb-4" itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
              <span itemprop="streetAddress">{loc.address}</span>
              <span class="block" itemprop="addressLocality">{loc.locality}</span>
              <span class="block" itemprop="addressRegion">{loc.county}</span>
              <meta itemprop="addressCountry" content="KE" />
            </address>
            <div class="rounded-xl bg-white p-4 border border-grey-light/30">
              <p class="font-accent text-xs uppercase tracking-wider text-green font-semibold mb-1">{c.dpcs.contextLabel}</p>
              <p class="font-body text-sm text-charcoal-light leading-relaxed">{loc.context[lang]}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-cream">
    <div class="section-container max-w-4xl">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-charcoal mb-8 flex items-center gap-3">
        <span class="w-1 h-8 bg-dynared rounded-full inline-block" aria-hidden="true"></span>
        {c.faqHeading}
      </h2>
      <div class="space-y-4">
        {c.faq.map((item) => (
          <details class="group bg-white rounded-xl border border-grey-light/40 overflow-hidden">
            <summary class="cursor-pointer px-6 py-4 font-heading text-base md:text-lg font-semibold text-charcoal flex items-start justify-between gap-4 hover:bg-dynared-50/40 transition-colors">
              <span>{item.q}</span>
              <span class="flex-shrink-0 text-dynared transition-transform group-open:rotate-180" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
              </span>
            </summary>
            <div class="px-6 pb-5 pt-1 border-t border-grey-light/30">
              <p class="font-body text-base text-charcoal-light leading-relaxed">{item.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-charcoal text-white relative overflow-hidden">
    <div class="absolute inset-0 grain-overlay opacity-20"></div>
    <div class="section-container relative z-10 max-w-3xl text-center">
      <h2 class="font-heading text-2xl md:text-3xl font-bold mb-4">{c.cta.heading}</h2>
      <p class="font-body text-base md:text-lg text-grey-light leading-relaxed mb-8">{c.cta.body}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`/${lang}/products`} class="btn-primary">{c.cta.primary}</a>
        <a href={`/${lang}/country-profiles`} class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-accent font-semibold border-2 border-white/40 hover:border-white hover:bg-white/10 transition-colors">
          {c.cta.secondary}
        </a>
      </div>
      <div class="mt-10">
        <a href={`/${lang}/country-profiles`} class="inline-flex items-center gap-2 font-accent text-sm text-grey-light hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
          {c.backLink}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
