    },
  },
  fr: {
    meta: {
      title: 'Dynapharm Kenya - 18 DPC et Profil Pays',
      description: 'Profil pays officiel de Dynapharm Kenya avec 18 DPC a Nairobi, Mombasa, Kisumu, Nakuru, Eldoret, Thika, Nyeri, Kitale, Ruiru, Voi, Kitengela et plus.',
      keywords: 'Dynapharm Kenya, Dynapharm Nairobi, Dynapharm Mombasa, Dynapharm Kisumu, Dynapharm Nakuru, Dynapharm Eldoret, Dynapharm Thika, Dynapharm Nyeri, Dynapharm Kitale, Dynapharm Ruiru, Dynapharm Kitengela, Dynapharm Kasarani, Dynapharm Buruburu, Dynapharm Hazina Towers, Dynapharm Sanlam, Dynapharm Norwich, produits naturels Kenya, Spiruline Kenya, Ganoderma Kenya, Chlorophylle Kenya, distributeur Dynapharm Kenya',
    },
    breadcrumbCountries: 'Profils des Pays',
    breadcrumbThis: 'Kenya',
    hero: {
      eyebrow: 'Profil Pays - Republique du Kenya',
      heading: 'Dynapharm Kenya',
      subtitle: 'Un reseau DPC national reliant Nairobi, la cote, le Kenya central, la Rift Valley, le lac Victoria et le North Rift aux produits bien-etre Dynapharm et au soutien distributeur.',
      flagAlt: 'Drapeau national de la Republique du Kenya',
    },
    overview: {
      heading: 'Un Reseau Kenya a Forte Visibilite',
      p1: 'Dynapharm Kenya sert l un des marches les plus connectes d Afrique de l Est avec 18 DPC listes. La presence commence dans le quartier central des affaires de Nairobi et s etend vers les grands corridors urbains, agricoles, cotiers et commerciaux interieurs.',
      p2: 'Le reseau couvre les recherches locales dans un langage pratique : Dynapharm Nairobi, Dynapharm Mombasa, Dynapharm Kisumu, Dynapharm Nakuru, Dynapharm Eldoret, Dynapharm Thika, Dynapharm Nyeri, Dynapharm Kitale, Dynapharm Ruiru, Dynapharm Kitengela, Dynapharm Buruburu et Dynapharm Kasarani.',
      p3: 'Utilisez cette page pour identifier le site Kenya le plus proche, comprendre son contexte regional, et vous connecter a l ecosysteme produits et opportunite d affaires Dynapharm au Kenya.',
      stats: [
        { value: '18', label: 'DPC' },
        { value: '13+', label: 'Villes et Zones Urbaines' },
        { value: '8+', label: 'Comtes Couverts' },
        { value: '90+', label: 'Produits' },
      ],
      mapAlt: 'Carte du Kenya aux couleurs du drapeau national',
    },
    clusters: {
      heading: 'Couverture Kenya par Corridor',
      subtitle: 'Les sites sont regroupes selon les recherches et les deplacements reels des clients : Nairobi, Kenya central, Rift Valley, lac Victoria, North Rift et cote.',
      placesLabel: 'Sites',
    },
    dpcs: {
      heading: 'Sites DPC Dynapharm Kenya',
      subtitle: 'Les codes DPC ont ete retires. Chaque fiche conserve le nom et l adresse fournis, puis ajoute un contexte regional pour le referencement local et la recherche IA.',
      addressLabel: 'Adresse',
      localityLabel: 'Localite',
      countyLabel: 'Comte',
      corridorLabel: 'Corridor',
      contextLabel: 'Contexte local',
    },
    feature: {
      heading: 'Structure pour la Recherche Locale au Kenya',
      body: 'La recherche au Kenya est fortement liee aux lieux. Un client peut chercher un repere du centre-ville, un quartier comme Buruburu ou Kasarani, une ville en croissance comme Ruiru ou Kitengela, ou une ville regionale comme Kisumu, Nakuru, Eldoret ou Mombasa. Cette page aide les moteurs de recherche et les moteurs IA a reconnaitre chaque site comme partie d un meme reseau Dynapharm Kenya.',
      points: [
        'Noms et adresses DPC clairs, sans codes internes',
        'Signaux pays, comte, localite et corridor pour une meilleure decouverte',
        'FAQ orientee vers les vraies questions clients et distributeurs',
      ],
      imageAlt: 'Drapeau du Kenya et paysage cotier representant la couverture Dynapharm Kenya',
    },
    faqHeading: 'Foire aux questions - Dynapharm Kenya',
    faq: [
      { q: 'Ou se trouve Dynapharm Kenya ?', a: 'Dynapharm Kenya liste des DPC a Nairobi CBD, Thika, Murang\'a, Mombasa, Kitale, Nakuru, Nyeri, Ruiru, Buruburu, Kitengela, Eldoret, Kisumu, Voi et Kasarani.' },
      { q: 'Combien de DPC Dynapharm Kenya sont listes ?', a: 'Ce profil pays liste 18 sites DPC au Kenya apres suppression des codes internes fournis dans la liste source.' },
      { q: 'Existe-t-il un site Dynapharm dans le centre de Nairobi ?', a: 'Oui. Les entrees Nairobi CBD comprennent Hazina Towers, Sanlam, Norwich et Accra, avec une couverture complementaire a Buruburu et Kasarani.' },
      { q: 'Dynapharm est-il disponible a Mombasa ?', a: 'Oui. La liste Kenya comprend Mombasa et Mombasa Qamar Plaza, pour soutenir les clients et distributeurs de la ville portuaire cotiere.' },
