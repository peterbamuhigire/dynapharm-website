---
import type { GetStaticPaths } from 'astro';
import { Image, getImage } from 'astro:assets';
import { SUPPORTED_LANGS } from '@utils/i18n';
import type { Lang } from '@utils/i18n';
import BaseLayout from '@layouts/BaseLayout.astro';

import kenyaFlag from '@assets/images/gallery/kenya-flag.jpg';
import kenyaMapFlag from '@assets/images/gallery/kenya-map-flag.jpg';
import kenyaMapCloseup from '@assets/images/gallery/kenya-map-closeup.jpg';
import kenyaCoastFlag from '@assets/images/gallery/kenya-coast-flag.jpg';

export const getStaticPaths = (() => {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Lang };

const heroBg = await getImage({ src: kenyaFlag, format: 'webp', width: 2000, quality: 75 });

interface KenyaLocation {
  name: string;
  address: string;
  locality: string;
  county: string;
  corridor: string;
  context: Record<Lang, string>;
}

const locations: KenyaLocation[] = [
  { name: 'Hazina Towers', address: 'Hazina Towers', locality: 'Nairobi CBD', county: 'Nairobi City County', corridor: 'Nairobi Central', context: { en: 'Central business district access near government, commercial and public transport activity.', fr: 'Acces au quartier central des affaires, proche des services publics, du commerce et des transports.' } },
  { name: 'Sanlam', address: 'Sanlam', locality: 'Nairobi CBD', county: 'Nairobi City County', corridor: 'Nairobi Central', context: { en: 'A Nairobi central location for customers searching from the inner-city office and retail core.', fr: 'Un point central a Nairobi pour les clients du noyau administratif et commercial.' } },
  { name: 'Norwich', address: 'Norwich', locality: 'Nairobi CBD', county: 'Nairobi City County', corridor: 'Nairobi Central', context: { en: 'Norwich Union House is associated with Mama Ngina Street in the heart of Nairobi CBD.', fr: 'Norwich Union House est associe a Mama Ngina Street, au coeur du centre-ville de Nairobi.' } },
  { name: 'Accra', address: 'Accra', locality: 'Nairobi CBD', county: 'Nairobi City County', corridor: 'Nairobi Central', context: { en: 'A high-footfall Nairobi CBD area useful for product pickup, distributor movement and local search.', fr: 'Un secteur tres frequente du centre de Nairobi, utile pour le retrait de produits et les distributeurs.' } },
  { name: 'Thika', address: 'Thika', locality: 'Thika', county: 'Kiambu County', corridor: 'Central & Thika Road', context: { en: 'An industrial and agricultural-processing town on the Thika Road growth corridor.', fr: 'Une ville industrielle et agro-industrielle situee sur le corridor de croissance de Thika Road.' } },
  { name: "Murang'a", address: "Murang'a", locality: "Murang'a", county: "Murang'a County", corridor: 'Central Highlands', context: { en: 'A Central Kenya highlands town linked with tea, coffee, farming communities and market trade.', fr: 'Une ville des hautes terres du Kenya central, liee au the, au cafe, a l agriculture et au commerce.' } },
  { name: 'Mombasa Qamar Plaza', address: 'Mombasa Qamar Plaza', locality: 'Mombasa', county: 'Mombasa County', corridor: 'Coast & Port', context: { en: 'Coastal access in Kenya\'s historic port city and Indian Ocean trade gateway.', fr: 'Acces cotier dans la ville portuaire historique du Kenya, ouverte sur le commerce de l Ocean Indien.' } },
  { name: 'Kitale', address: 'Kitale', locality: 'Kitale', county: 'Trans Nzoia County', corridor: 'North Rift', context: { en: 'A North Rift agricultural hub and Trans Nzoia administrative centre.', fr: 'Un pole agricole du North Rift et centre administratif de Trans Nzoia.' } },
  { name: 'Mombasa', address: 'Mombasa', locality: 'Mombasa', county: 'Mombasa County', corridor: 'Coast & Port', context: { en: 'Kenya\'s main coastal city, important for port, tourism, logistics and regional movement.', fr: 'La principale ville cotiere du Kenya, importante pour le port, le tourisme, la logistique et les echanges.' } },
  { name: 'Nakuru', address: 'Nakuru', locality: 'Nakuru', county: 'Nakuru County', corridor: 'Rift Valley', context: { en: 'A Rift Valley city with strong agriculture, manufacturing, transport and tourism links.', fr: 'Une ville de la Rift Valley avec des liens forts dans l agriculture, l industrie, le transport et le tourisme.' } },
  { name: 'Nyeri', address: 'Nyeri', locality: 'Nyeri', county: 'Nyeri County', corridor: 'Central Highlands', context: { en: 'A Mount Kenya highlands town near the Aberdare and Mount Kenya tourism and farming belt.', fr: 'Une ville des hautes terres du mont Kenya, proche de la zone agricole et touristique des Aberdare et du mont Kenya.' } },
  { name: 'Ruiru', address: 'Ruiru', locality: 'Ruiru', county: 'Kiambu County', corridor: 'Nairobi Metro', context: { en: 'A fast-growing Nairobi metropolitan municipality along the Thika Superhighway corridor.', fr: 'Une municipalite en forte croissance dans la metropole de Nairobi, le long de Thika Superhighway.' } },
  { name: 'Buruburu', address: 'Buruburu', locality: 'Buruburu, Nairobi', county: 'Nairobi City County', corridor: 'Nairobi Eastlands', context: { en: 'A major Eastlands residential estate with strong neighbourhood retail and commuter activity.', fr: 'Un grand quartier residentiel d Eastlands, avec commerce de proximite et forte mobilite quotidienne.' } },
  { name: 'Kitengela', address: 'Kitengela', locality: 'Kitengela', county: 'Kajiado County', corridor: 'Nairobi Metro South', context: { en: 'A rapidly urbanising Kajiado municipality south of Nairobi and part of the wider metropolitan area.', fr: 'Une municipalite de Kajiado en urbanisation rapide, au sud de Nairobi et dans l aire metropolitaine.' } },
  { name: 'Eldoret', address: 'Eldoret', locality: 'Eldoret', county: 'Uasin Gishu County', corridor: 'North Rift', context: { en: 'A North Rift city on the road and rail route towards western Kenya and Uganda.', fr: 'Une ville du North Rift situee sur l axe routier et ferroviaire vers l ouest du Kenya et l Ouganda.' } },
  { name: 'Kisumu', address: 'Kisumu', locality: 'Kisumu', county: 'Kisumu County', corridor: 'Lake Victoria', context: { en: 'Kenya\'s Lake Victoria city, an inland port and western Kenya commercial centre.', fr: 'La ville kenyane du lac Victoria, port interieur et centre commercial de l ouest du Kenya.' } },
  { name: 'Voi', address: 'Voi', locality: 'Voi', county: 'Taita Taveta County', corridor: 'Coast & Tsavo', context: { en: 'A strategic town on the Nairobi-Mombasa route and gateway to the Tsavo landscape.', fr: 'Une ville strategique sur l axe Nairobi-Mombasa et porte d entree vers le paysage de Tsavo.' } },
  { name: 'Kasarani', address: 'Kasarani', locality: 'Kasarani, Nairobi', county: 'Nairobi City County', corridor: 'Nairobi Thika Road', context: { en: 'A mixed-use northeast Nairobi area on the Thika Road urban corridor.', fr: 'Un secteur mixte du nord-est de Nairobi, situe sur le corridor urbain de Thika Road.' } },
];

const clusters = [
  {
    name: { en: 'Nairobi CBD & Metropolitan Reach', fr: 'Nairobi CBD et Aire Metropolitaine' },
    places: ['Hazina Towers', 'Sanlam', 'Norwich', 'Accra', 'Buruburu', 'Kasarani', 'Ruiru', 'Kitengela'],
    body: {
      en: 'The Kenya network is anchored in Nairobi, from CBD footfall to Eastlands, Thika Road and the southern metropolitan corridor.',
      fr: 'Le reseau Kenya est ancre a Nairobi, du centre-ville tres frequente a Eastlands, Thika Road et le corridor metropolitain sud.',
    },
  },
  {
    name: { en: 'Central Highlands', fr: 'Hautes Terres Centrales' },
    places: ['Thika', "Murang'a", 'Nyeri'],
    body: {
      en: 'Central Kenya locations support market towns, farming communities, tea and coffee belts, and customers around Mount Kenya.',
      fr: 'Les sites du Kenya central couvrent les villes de marche, les communautes agricoles, les zones the/cafe et les clients autour du mont Kenya.',
    },
  },
  {
    name: { en: 'Rift Valley, Lake & North Rift', fr: 'Rift Valley, Lac et North Rift' },
    places: ['Nakuru', 'Eldoret', 'Kisumu', 'Kitale'],
    body: {
      en: 'Western and Rift Valley coverage links agricultural towns, Lake Victoria trade, and the North Rift transport corridor.',
      fr: 'La couverture ouest et Rift Valley relie les villes agricoles, le commerce du lac Victoria et le corridor de transport du North Rift.',
    },
  },
  {
    name: { en: 'Coast & Tsavo Route', fr: 'Cote et Axe de Tsavo' },
    places: ['Mombasa Qamar Plaza', 'Mombasa', 'Voi'],
    body: {
      en: 'Coastal and Mombasa-road locations connect port-city customers, tourism communities and movement towards Tsavo.',
      fr: 'Les sites cotiers et de l axe Mombasa relient les clients de la ville portuaire, les communautes touristiques et le mouvement vers Tsavo.',
    },
  },
];

const content = {
  en: {
    meta: {
      title: 'Dynapharm Kenya - 18 DPC Locations & Country Profile',
      description: 'Official Dynapharm Kenya country profile with 18 DPC locations in Nairobi, Mombasa, Kisumu, Nakuru, Eldoret, Thika, Nyeri, Kitale, Ruiru, Voi, Kitengela and more.',
      keywords: 'Dynapharm Kenya, Dynapharm Nairobi, Dynapharm Mombasa, Dynapharm Kisumu, Dynapharm Nakuru, Dynapharm Eldoret, Dynapharm Thika, Dynapharm Nyeri, Dynapharm Kitale, Dynapharm Ruiru, Dynapharm Kitengela, Dynapharm Kasarani, Dynapharm Buruburu, Dynapharm Hazina Towers, Dynapharm Sanlam, Dynapharm Norwich, Dynapharm Accra Road, natural health products Kenya, Spirulina Kenya, Ganoderma coffee Kenya, Chlorophyll Kenya, Dynapharm distributor Kenya, wellness business Kenya',
    },
    breadcrumbCountries: 'Country Profiles',
    breadcrumbThis: 'Kenya',
    hero: {
      eyebrow: 'Country Profile - Republic of Kenya',
      heading: 'Dynapharm Kenya',
      subtitle: 'A nationwide DPC footprint linking Nairobi, the coast, Central Kenya, the Rift Valley, Lake Victoria and the North Rift with Dynapharm wellness products and distributor support.',
      flagAlt: 'National flag of the Republic of Kenya',
    },
    overview: {
      heading: 'A High-Visibility Kenya Network',
      p1: 'Dynapharm Kenya serves one of East Africa\'s most connected markets through 18 listed DPC locations. The footprint starts in Nairobi\'s central business district and extends through major urban, agricultural, coastal and inland trading corridors.',
      p2: 'The network covers customer search intent in practical language: Dynapharm Nairobi, Dynapharm Mombasa, Dynapharm Kisumu, Dynapharm Nakuru, Dynapharm Eldoret, Dynapharm Thika, Dynapharm Nyeri, Dynapharm Kitale, Dynapharm Ruiru, Dynapharm Kitengela, Dynapharm Buruburu and Dynapharm Kasarani.',
      p3: 'Use this page to identify the nearest Kenya location, understand the regional context, and connect with the Dynapharm product and business opportunity ecosystem across Kenya.',
      stats: [
        { value: '18', label: 'DPC Locations' },
        { value: '13+', label: 'Towns & Urban Areas' },
        { value: '8+', label: 'Counties Reached' },
        { value: '90+', label: 'Products' },
      ],
      mapAlt: 'Map of Kenya coloured with the national flag',
    },
    clusters: {
      heading: 'Kenya Coverage by Corridor',
      subtitle: 'Locations are grouped by how customers actually search and travel: Nairobi, Central Kenya, the Rift Valley, Lake Victoria, the North Rift and the coast.',
      placesLabel: 'Locations',
    },
    dpcs: {
      heading: 'Dynapharm Kenya DPC Locations',
      subtitle: 'DPC codes have been removed. Each listing keeps the location name and address supplied, then adds regional context for local SEO and AI search clarity.',
      addressLabel: 'Address',
      localityLabel: 'Locality',
      countyLabel: 'County',
      corridorLabel: 'Corridor',
      contextLabel: 'Local context',
    },
    feature: {
      heading: 'Built for Local Search in Kenya',
      body: 'Kenya search behaviour is highly place-based. A customer may search for a CBD landmark, a neighbourhood such as Buruburu or Kasarani, a fast-growing commuter town such as Ruiru or Kitengela, or a regional city such as Kisumu, Nakuru, Eldoret or Mombasa. This page is structured so search engines and AI answer engines can recognise each location as part of one Kenya-wide Dynapharm network.',
