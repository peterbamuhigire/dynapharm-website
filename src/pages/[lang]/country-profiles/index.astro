---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { SUPPORTED_LANGS } from '@utils/i18n';
import type { Lang } from '@utils/i18n';
import BaseLayout from '@layouts/BaseLayout.astro';

import namibiaMap from '@assets/images/gallery/namibia-map-flag.jpg';
import guineaMap from '@assets/images/gallery/guinea-map-flag.jpg';

export const getStaticPaths = (() => {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Lang };

const content = {
  en: {
    meta: {
      title: 'Country Profiles — Dynapharm Africa Franchises by Country',
      description: 'Browse Dynapharm country profiles by country: Namibia (15 outlets), Guinea (6 outlets) and more. Find addresses, phone numbers and the Dynapharm business opportunity in your country across Africa and beyond.',
      keywords: 'Dynapharm country profiles, Dynapharm Namibia, Dynapharm Guinea, Dynapharm Guinée, Dynapharm Africa franchises, Dynapharm outlets directory, Dynapharm distributors Africa, where to buy Dynapharm Africa',
    },
    hero: {
      heading: 'Country Profiles',
      subtitle: 'Global reach, local presence. Explore the Dynapharm franchises that serve communities across Africa and beyond — country by country.',
    },
    intro: {
      heading: 'A Continent of Wellness',
      body: 'Dynapharm operates in more than 40 countries, with each franchise rooted in its own community. Our country profiles bring you closer to the people, outlets and stories that make Dynapharm Africa what it is. We continue adding profiles as franchises share their information.',
    },
    featuredTag: 'Country',
    countries: [
      {
        name: 'Namibia',
        slug: 'namibia',
        tagline: '15 outlets nationwide — Windhoek to Katima Mulilo',
        description: 'Dynapharm Namibia operates 15 outlets across 8 regions, from the capital Windhoek and the coastal cities of Swakopmund and Walvis Bay to northern hubs like Oshakati, Ondangwa and Katima Mulilo.',
        cta: 'View Namibia Profile',
        image: namibiaMap,
        imageAlt: 'Map of Namibia in the colours of the Namibian flag',
        outletsCount: 15,
        regions: 8,
      },
      {
        name: 'Guinea',
        slug: 'guinea',
        tagline: '6 outlets — Conakry, Boké, Labé, Faranah, Siguiri',
        description: 'Dynapharm Guinea (Guinée) operates outlets in Conakry (Dixinn and Sangoyah), plus Boké, Labé, Faranah and Siguiri — covering Lower, Middle and Upper Guinea.',
        cta: 'View Guinea Profile',
        image: guineaMap,
        imageAlt: 'Map of the Republic of Guinea in the colours of the Guinean flag',
        outletsCount: 6,
        regions: 5,
      },
    ],
    outletsLabel: 'outlets',
    regionsLabel: 'regions',
    comingSoonHeading: 'More Country Profiles Coming Soon',
    comingSoonBody: 'We are gathering profiles from franchises across the continent — Uganda, Kenya, Tanzania, Nigeria, Senegal, Ghana, Cameroon, Zambia, Mozambique, South Africa, Côte d’Ivoire, Burkina Faso, Mali, Togo, Benin, Rwanda, Burundi, DRC and more. If you represent a Dynapharm franchise and would like to be featured, please get in touch.',
    contactCta: 'Contact Us to Be Featured',
  },
  fr: {
    meta: {
      title: 'Profils des Pays — Franchises Dynapharm Africa par Pays',
      description: 'Parcourez les profils pays Dynapharm : Namibie (15 points de vente), Guinée (6 points de vente) et plus. Trouvez les adresses, numéros de téléphone et l’opportunité d’affaires Dynapharm dans votre pays à travers l’Afrique et au-delà.',
      keywords: 'profils pays Dynapharm, Dynapharm Namibie, Dynapharm Guinée, franchises Dynapharm Afrique, annuaire points de vente Dynapharm, distributeurs Dynapharm Afrique, où acheter Dynapharm Afrique',
    },
    hero: {
      heading: 'Profils des Pays',
      subtitle: 'Présence mondiale, ancrage local. Explorez les franchises Dynapharm qui servent les communautés à travers l’Afrique et au-delà — pays par pays.',
    },
    intro: {
      heading: 'Un Continent de Bien-Être',
      body: 'Dynapharm opère dans plus de 40 pays, chaque franchise étant ancrée dans sa propre communauté. Nos profils pays vous rapprochent des personnes, des points de vente et des histoires qui font de Dynapharm Africa ce qu’elle est. Nous continuons d’ajouter des profils au fur et à mesure que les franchises partagent leurs informations.',
    },
    featuredTag: 'Pays',
    countries: [
      {
        name: 'Namibie',
        slug: 'namibia',
        tagline: '15 points de vente — de Windhoek à Katima Mulilo',
        description: 'Dynapharm Namibie exploite 15 points de vente dans 8 régions, de la capitale Windhoek aux villes côtières de Swakopmund et Walvis Bay, jusqu’aux pôles du nord comme Oshakati, Ondangwa et Katima Mulilo.',
        cta: 'Voir le Profil de la Namibie',
        image: namibiaMap,
        imageAlt: 'Carte de la Namibie aux couleurs du drapeau namibien',
        outletsCount: 15,
        regions: 8,
      },
      {
        name: 'Guinée',
        slug: 'guinea',
        tagline: '6 points de vente — Conakry, Boké, Labé, Faranah, Siguiri',
        description: 'Dynapharm Guinée exploite des points de vente à Conakry (Dixinn et Sangoyah), ainsi qu’à Boké, Labé, Faranah et Siguiri — couvrant la Basse, la Moyenne et la Haute-Guinée.',
        cta: 'Voir le Profil de la Guinée',
        image: guineaMap,
        imageAlt: 'Carte de la République de Guinée aux couleurs du drapeau guinéen',
        outletsCount: 6,
        regions: 5,
      },
    ],
    outletsLabel: 'points de vente',
    regionsLabel: 'régions',
    comingSoonHeading: 'D’Autres Profils Pays à Venir',
    comingSoonBody: 'Nous rassemblons les profils des franchises à travers le continent — Ouganda, Kenya, Tanzanie, Nigeria, Sénégal, Ghana, Cameroun, Zambie, Mozambique, Afrique du Sud, Côte d’Ivoire, Burkina Faso, Mali, Togo, Bénin, Rwanda, Burundi, RDC et bien d’autres. Si vous représentez une franchise Dynapharm et souhaitez être mis en avant, veuillez nous contacter.',
    contactCta: 'Contactez-nous pour Apparaître ici',
  },
};

const c = content[lang];
const siteHref = (Astro.site?.href || 'https://dynapharmafrica.com/').replace(/\/$/, '');

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: c.hero.heading,
  itemListElement: c.countries.map((country, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: `Dynapharm ${country.name}`,
    url: `${siteHref}/${lang}/country-profiles/${country.slug}`,
    description: country.description,
  })),
};
---

<BaseLayout
  title={c.meta.title}
  description={c.meta.description}
  keywords={c.meta.keywords}
  lang={lang}
  structuredData={itemListSchema}
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-charcoal via-charcoal to-dynared-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 grain-overlay opacity-30"></div>
    <div class="section-container relative z-10 py-16 md:py-24">
      <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold mb-4">
        {c.hero.heading}
      </h1>
      <p class="font-body text-lg md:text-xl text-grey-light max-w-2xl">
        {c.hero.subtitle}
      </p>
    </div>
    <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-none">
      <svg viewBox="0 0 1200 60" preserveAspectRatio="none" class="w-full h-8 md:h-12">
        <polygon fill="var(--color-cream)" points="0,60 1200,60 1200,0"></polygon>
      </svg>
    </div>
  </section>

  <!-- Intro -->
  <section class="section-padding bg-cream">
    <div class="section-container max-w-4xl">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-charcoal mb-4 flex items-center gap-3">
        <span class="w-1 h-8 bg-dynared rounded-full inline-block" aria-hidden="true"></span>
        {c.intro.heading}
      </h2>
      <p class="font-body text-base md:text-lg text-charcoal-light leading-relaxed">
        {c.intro.body}
      </p>
    </div>
  </section>

  <!-- Country Cards -->
  <section class="section-padding bg-white">
    <div class="section-container">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {c.countries.map((country) => (
          <a
            href={`/${lang}/country-profiles/${country.slug}`}
            class="group block bg-cream rounded-2xl overflow-hidden border border-grey-light/40 hover:border-dynared/50 hover:shadow-xl transition-all duration-300"
          >
            <div class="relative aspect-[4/3] overflow-hidden bg-white flex items-center justify-center p-4">
              <Image
                src={country.image}
                alt={country.imageAlt}
                class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
                widths={[400, 800]}
                sizes="(min-width: 1024px) 400px, (min-width: 768px) 50vw, 100vw"
                loading="lazy"
              />
              <span class="absolute top-4 left-4 inline-flex items-center px-3 py-1 rounded-full bg-dynared text-white text-xs font-accent font-semibold uppercase tracking-wider">
                {c.featuredTag}
              </span>
            </div>
            <div class="p-6">
              <h3 class="font-heading text-2xl font-bold text-charcoal mb-2 group-hover:text-dynared transition-colors duration-200">
                {country.name}
              </h3>
              <p class="font-accent text-sm text-dynared font-semibold mb-3">
                {country.tagline}
              </p>
              <p class="font-body text-base text-charcoal-light leading-relaxed mb-4">
                {country.description}
              </p>
              <div class="flex gap-4 mb-4 text-xs font-accent text-charcoal-light">
                <span><strong class="text-dynared">{country.outletsCount}</strong> {c.outletsLabel}</span>
                <span><strong class="text-dynared">{country.regions}</strong> {c.regionsLabel}</span>
              </div>
              <span class="inline-flex items-center gap-2 font-accent text-sm font-semibold text-dynared">
                {country.cta}
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7-7 7M5 12h16" /></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Coming Soon CTA -->
  <section class="section-padding bg-cream">
    <div class="section-container max-w-3xl text-center">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-charcoal mb-4">
        {c.comingSoonHeading}
      </h2>
      <p class="font-body text-base md:text-lg text-charcoal-light leading-relaxed mb-8">
        {c.comingSoonBody}
      </p>
      <a href={`/${lang}/contact`} class="btn-primary">
        {c.contactCta}
      </a>
    </div>
  </section>
</BaseLayout>
