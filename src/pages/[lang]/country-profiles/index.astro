---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { SUPPORTED_LANGS } from '@utils/i18n';
import type { Lang } from '@utils/i18n';
import BaseLayout from '@layouts/BaseLayout.astro';

import botswanaMap from '@assets/images/gallery/botswana-map-flag.jpg';
import guineaMap from '@assets/images/gallery/guinea-map-flag.jpg';
import namibiaMap from '@assets/images/gallery/namibia-map-flag.jpg';
import rwandaMap from '@assets/images/gallery/rwanda-map-flag.jpg';

export const getStaticPaths = (() => {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Lang };

const content = {
  en: {
    meta: {
      title: 'Dynapharm Country Profiles - Botswana, Guinea, Namibia, Rwanda DPCs & Outlets',
      description: 'Browse official Dynapharm country profiles in alphabetical order: Botswana DPCs, Guinea outlets, Namibia outlets, Rwanda contacts and more. Find local addresses, contact details, natural health products, DI Grow and the Dynapharm business opportunity across Africa.',
      keywords: 'Dynapharm country profiles, Dynapharm Botswana, Dynapharm Guinea, Dynapharm Namibia, Dynapharm Rwanda, DI Grow Rwanda, DI Grow Seed Limited, Dynapharm DPC addresses, Dynapharm outlets directory, Dynapharm Africa franchises, Dynapharm distributors Africa, where to buy Dynapharm, natural health products Africa, Spirulina Africa, Ganoderma coffee Africa, Dynapharm business opportunity Africa',
    },
    hero: {
      heading: 'Country Profiles',
      subtitle: 'Global reach, local presence. Explore Dynapharm franchises, DPCs, outlet addresses and distributor support country by country.',
    },
    intro: {
      heading: 'A Continent of Wellness',
      body: 'Dynapharm operates in more than 40 countries, with each franchise rooted in its own community. These country profiles are built for local search: DPC addresses, outlet towns, contact details, products, distributor enquiries and business opportunity information in one place.',
    },
    featuredTag: 'Country',
    countries: [
      {
        name: 'Botswana',
        slug: 'botswana',
        tagline: '7 DPCs - Gaborone, Francistown, Maun, Serowe and more',
        description: 'Dynapharm Botswana lists DPC addresses in Gaborone, Francistown, Serowe, Maun, Kanye, Mahalapye and Molepolole, with the Botswana contact email for product and distributor enquiries.',
        cta: 'View Botswana Profile',
        image: botswanaMap,
        imageAlt: 'Map of Botswana in the colours of the Botswana flag',
        outletsCount: 7,
        regions: 5,
      },
      {
        name: 'Guinea',
        slug: 'guinea',
        tagline: '6 outlets - Conakry, Boké, Labé, Faranah, Siguiri',
        description: 'Dynapharm Guinea operates outlets in Conakry (Dixinn and Sangoyah), plus Boké, Labé, Faranah and Siguiri, covering Lower, Middle and Upper Guinea.',
        cta: 'View Guinea Profile',
        image: guineaMap,
        imageAlt: 'Map of the Republic of Guinea in the colours of the Guinean flag',
        outletsCount: 6,
        regions: 5,
      },
      {
        name: 'Namibia',
        slug: 'namibia',
        tagline: '15 outlets nationwide - Windhoek to Katima Mulilo',
        description: 'Dynapharm Namibia operates 15 outlets across 8 regions, from Windhoek and coastal Swakopmund and Walvis Bay to northern hubs like Oshakati, Ondangwa and Katima Mulilo.',
        cta: 'View Namibia Profile',
        image: namibiaMap,
        imageAlt: 'Map of Namibia in the colours of the Namibian flag',
        outletsCount: 15,
        regions: 8,
      },
      {
        name: 'Rwanda',
        slug: 'rwanda',
        tagline: 'Kigali contacts - Dynapharm Rwanda and DI Grow Seed Limited',
        description: 'Dynapharm Rwanda handles the wellness and food supplements arm, while DI Grow Seed Limited supplies DI Grow Organic Foliar Fertilizer for Rwanda agricultural customers.',
        cta: 'View Rwanda Profile',
        image: rwandaMap,
        imageAlt: 'Map of Rwanda in the colours of the Rwandan flag',
        outletsCount: 2,
        regions: 1,
      },
    ],
    outletsLabel: 'locations',
    regionsLabel: 'regions',
    comingSoonHeading: 'More Country Profiles Coming Soon',
    comingSoonBody: 'We are gathering profiles from franchises across the continent - Uganda, Kenya, Tanzania, Nigeria, Senegal, Ghana, Cameroon, Zambia, Mozambique, South Africa, Côte d\'Ivoire, Burkina Faso, Mali, Togo, Benin, Burundi, DRC and more. If you represent a Dynapharm franchise and would like to be featured, please get in touch.',
    contactCta: 'Contact Us to Be Featured',
  },
  fr: {
    meta: {
      title: 'Profils Pays Dynapharm - Botswana, Guinée, Namibie, Rwanda',
      description: 'Parcourez les profils pays officiels Dynapharm par ordre alphabétique : DPC Botswana, points de vente Guinée, points de vente Namibie, contacts Rwanda et plus. Trouvez les adresses locales, contacts, produits naturels, DI Grow et l\'opportunité d\'affaires Dynapharm en Afrique.',
      keywords: 'profils pays Dynapharm, Dynapharm Botswana, Dynapharm Guinée, Dynapharm Namibie, Dynapharm Rwanda, DI Grow Rwanda, DI Grow Seed Limited, DPC Dynapharm, adresses Dynapharm, annuaire points de vente Dynapharm, franchises Dynapharm Afrique, distributeurs Dynapharm Afrique, où acheter Dynapharm, produits naturels Afrique, Spiruline Afrique, Ganoderma Afrique',
    },
    hero: {
      heading: 'Profils des Pays',
      subtitle: 'Présence mondiale, ancrage local. Explorez les franchises Dynapharm, les DPC, les adresses et le soutien distributeur pays par pays.',
    },
    intro: {
      heading: 'Un Continent de Bien-Être',
      body: 'Dynapharm opère dans plus de 40 pays, chaque franchise étant ancrée dans sa propre communauté. Ces profils pays sont préparés pour la recherche locale : adresses DPC, villes, contacts, produits, demandes distributeurs et opportunité d\'affaires en un seul endroit.',
    },
    featuredTag: 'Pays',
    countries: [
      {
        name: 'Botswana',
        slug: 'botswana',
        tagline: '7 DPC - Gaborone, Francistown, Maun, Serowe et plus',
        description: 'Dynapharm Botswana présente les adresses DPC à Gaborone, Francistown, Serowe, Maun, Kanye, Mahalapye et Molepolole, avec l\'email de contact Botswana pour les produits et distributeurs.',
        cta: 'Voir le Profil du Botswana',
        image: botswanaMap,
        imageAlt: 'Carte du Botswana aux couleurs du drapeau botswanais',
        outletsCount: 7,
        regions: 5,
      },
      {
        name: 'Guinée',
        slug: 'guinea',
        tagline: '6 points de vente - Conakry, Boké, Labé, Faranah, Siguiri',
        description: 'Dynapharm Guinée exploite des points de vente à Conakry (Dixinn et Sangoyah), ainsi qu\'à Boké, Labé, Faranah et Siguiri, couvrant la Basse, la Moyenne et la Haute-Guinée.',
        cta: 'Voir le Profil de la Guinée',
        image: guineaMap,
        imageAlt: 'Carte de la République de Guinée aux couleurs du drapeau guinéen',
        outletsCount: 6,
        regions: 5,
      },
      {
        name: 'Namibie',
        slug: 'namibia',
        tagline: '15 points de vente - de Windhoek à Katima Mulilo',
        description: 'Dynapharm Namibie exploite 15 points de vente dans 8 régions, de Windhoek aux villes côtières de Swakopmund et Walvis Bay, jusqu\'aux pôles du nord comme Oshakati, Ondangwa et Katima Mulilo.',
        cta: 'Voir le Profil de la Namibie',
        image: namibiaMap,
        imageAlt: 'Carte de la Namibie aux couleurs du drapeau namibien',
        outletsCount: 15,
        regions: 8,
      },
      {
        name: 'Rwanda',
        slug: 'rwanda',
        tagline: 'Contacts Kigali - Dynapharm Rwanda et DI Grow Seed Limited',
        description: 'Dynapharm Rwanda gere les complements alimentaires et produits bien-etre, tandis que DI Grow Seed Limited fournit DI Grow Organic Foliar Fertilizer pour les clients agricoles au Rwanda.',
        cta: 'Voir le Profil du Rwanda',
        image: rwandaMap,
        imageAlt: 'Carte du Rwanda aux couleurs du drapeau rwandais',
        outletsCount: 2,
        regions: 1,
      },
    ],
    outletsLabel: 'sites',
    regionsLabel: 'régions',
    comingSoonHeading: 'D\'Autres Profils Pays à Venir',
    comingSoonBody: 'Nous rassemblons les profils des franchises à travers le continent - Ouganda, Kenya, Tanzanie, Nigeria, Sénégal, Ghana, Cameroun, Zambie, Mozambique, Afrique du Sud, Côte d\'Ivoire, Burkina Faso, Mali, Togo, Bénin, Burundi, RDC et bien d\'autres. Si vous représentez une franchise Dynapharm et souhaitez être mis en avant, veuillez nous contacter.',
    contactCta: 'Contactez-nous pour Apparaître ici',
  },
};

const c = content[lang];
const siteHref = (Astro.site?.href || 'https://dynapharmafrica.com/').replace(/\/$/, '');
const pageUrl = `${siteHref}/${lang}/country-profiles`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: lang === 'fr' ? 'Accueil' : 'Home', item: `${siteHref}/${lang}` },
    { '@type': 'ListItem', position: 2, name: c.hero.heading, item: pageUrl },
  ],
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: c.meta.title,
  url: pageUrl,
  description: c.meta.description,
  inLanguage: lang,
  keywords: c.meta.keywords,
  about: [
    { '@type': 'Organization', name: 'Dynapharm Africa' },
    { '@type': 'Thing', name: 'Dynapharm DPC addresses' },
    { '@type': 'Thing', name: 'Dynapharm business opportunity' },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: c.hero.heading,
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: c.countries.length,
  itemListElement: c.countries.map((country, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: `Dynapharm ${country.name}`,
    url: `${siteHref}/${lang}/country-profiles/${country.slug}`,
    description: country.description,
  })),
};
---

<BaseLayout
  title={c.meta.title}
  description={c.meta.description}
  keywords={c.meta.keywords}
  lang={lang}
  structuredData={[breadcrumbSchema, webPageSchema, itemListSchema]}
>
  <section class="bg-gradient-to-br from-charcoal via-charcoal to-dynared-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 grain-overlay opacity-30"></div>
    <div class="section-container relative z-10 py-16 md:py-24">
      <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold mb-4">
        {c.hero.heading}
      </h1>
      <p class="font-body text-lg md:text-xl text-grey-light max-w-2xl">
        {c.hero.subtitle}
      </p>
    </div>
    <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-none">
      <svg viewBox="0 0 1200 60" preserveAspectRatio="none" class="w-full h-8 md:h-12">
        <polygon fill="var(--color-cream)" points="0,60 1200,60 1200,0"></polygon>
      </svg>
    </div>
  </section>

  <section class="section-padding bg-cream">
    <div class="section-container max-w-4xl">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-charcoal mb-4 flex items-center gap-3">
        <span class="w-1 h-8 bg-dynared rounded-full inline-block" aria-hidden="true"></span>
        {c.intro.heading}
      </h2>
      <p class="font-body text-base md:text-lg text-charcoal-light leading-relaxed">
        {c.intro.body}
      </p>
    </div>
  </section>

  <section class="section-padding bg-white">
    <div class="section-container">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {c.countries.map((country) => (
          <a
            href={`/${lang}/country-profiles/${country.slug}`}
            class="group block bg-cream rounded-2xl overflow-hidden border border-grey-light/40 hover:border-dynared/50 hover:shadow-xl transition-all duration-300"
          >
            <div class="relative aspect-[4/3] overflow-hidden bg-white flex items-center justify-center p-4">
              <Image
                src={country.image}
                alt={country.imageAlt}
                class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
                widths={[400, 800]}
                sizes="(min-width: 1024px) 400px, (min-width: 768px) 50vw, 100vw"
                loading="lazy"
              />
              <span class="absolute top-4 left-4 inline-flex items-center px-3 py-1 rounded-full bg-dynared text-white text-xs font-accent font-semibold uppercase tracking-wider">
                {c.featuredTag}
              </span>
            </div>
            <div class="p-6">
              <h3 class="font-heading text-2xl font-bold text-charcoal mb-2 group-hover:text-dynared transition-colors duration-200">
                {country.name}
              </h3>
              <p class="font-accent text-sm text-dynared font-semibold mb-3">
                {country.tagline}
              </p>
              <p class="font-body text-base text-charcoal-light leading-relaxed mb-4">
                {country.description}
              </p>
              <div class="flex gap-4 mb-4 text-xs font-accent text-charcoal-light">
                <span><strong class="text-dynared">{country.outletsCount}</strong> {c.outletsLabel}</span>
                <span><strong class="text-dynared">{country.regions}</strong> {c.regionsLabel}</span>
              </div>
              <span class="inline-flex items-center gap-2 font-accent text-sm font-semibold text-dynared">
                {country.cta}
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7-7 7M5 12h16" /></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-cream">
    <div class="section-container max-w-3xl text-center">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-charcoal mb-4">
        {c.comingSoonHeading}
      </h2>
      <p class="font-body text-base md:text-lg text-charcoal-light leading-relaxed mb-8">
        {c.comingSoonBody}
      </p>
      <a href={`/${lang}/contact`} class="btn-primary">
        {c.contactCta}
      </a>
    </div>
  </section>
</BaseLayout>
